# Local dev VM (UTM, ARM fnOS).
# Copy to .env.local and fill in real values there; .env.local is ignored, this file is committed.

# UTM VM name
FNOS_VM_NAME=fnOS-dev
# VM IP on the UTM shared network
FNOS_VM_HOST=192.168.xxx.xxx
# fnOS admin account on the VM
FNOS_VM_USER=
FNOS_VM_PASSWORD=
# UTM serial console (TCP, loopback only)
FNOS_VM_SERIAL=127.0.0.1:4555
FNOS_VM_SSH_KEY=~/.ssh/fnos_dev_ed25519

# Bring-your-own-key provider for the custom-provider acceptance test
# (web wizard: add the DeepSeek preset, fetch models, stream a reply).
# Use a key with a small balance; it is typed into the browser, never committed.
DEEPSEEK_API_KEY=
