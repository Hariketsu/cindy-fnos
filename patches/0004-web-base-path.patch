+// A reverse proxy can serve the page below the site root and set the prefix
+// before the shim runs. Host calls, the event stream and logout must keep it.
+test('a proxy path prefix reaches Host requests, events and the logout redirect', async () => {
+  const streams = [];
+  const b = browser(() => ({}), `window.__CINDY_BASE__ = '/cindy/';${source}`, (url, { signal }) => {
+    streams.push(url);
+    return new Promise((_resolve, reject) => signal.addEventListener('abort', () => reject(signal.reason), { once: true }));
+  });
+  await b.api.auth.getState();
+  await b.api.authLogout();
+  const urls = b.calls.map(c => c.url);
+  assert.ok(urls.includes('/cindy/api/auth/state') && urls.includes('/cindy/api/auth/logout'), urls.join());
+  assert.ok(urls.every(url => url.startsWith('/cindy/api/')), urls.join());
+  assert.deepEqual(b.redirects, ['/cindy/connect']);
+  assert.ok(streams.length > 0 && streams.every(url => url.startsWith('/cindy/events?')), streams.join());
+});
