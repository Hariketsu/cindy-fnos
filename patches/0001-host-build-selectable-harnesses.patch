new file mode 100644
index 0000000000..6e2719a9fe
--- /dev/null
+++ b/apps/host/src/release-harnesses.mjs
@@ -0,0 +1,27 @@
+/** Agent harness runtimes a standalone Host release can bundle (`apps/<name>/<platform>`). */
+export const RELEASE_HARNESSES = Object.freeze(['claude-code-bin', 'codex-package-bin', 'pi-bin', 'ripgrep-bin']);
+
+/**
+ * Choose which harnesses a release bundles. `--harnesses` takes precedence over
+ * `CINDY_HOST_HARNESSES`; with neither, every harness is bundled as before.
+ * Unknown names fail fast so a typo cannot ship a release missing an agent.
+ *
+ * @param {{ option?: string, env?: NodeJS.ProcessEnv }} [input]
+ * @returns {{ harnesses: string[], warnings: string[] }}
+ */
+export function selectReleaseHarnesses({ option, env = process.env } = {}) {
+  const raw = option ?? env.CINDY_HOST_HARNESSES;
+  if (raw === undefined || raw.trim() === '') return { harnesses: [...RELEASE_HARNESSES], warnings: [] };
+  const requested = new Set(raw.split(',').map(name => name.trim()).filter(Boolean));
+  const unknown = [...requested].filter(name => !RELEASE_HARNESSES.includes(name));
+  if (unknown.length) {
+    throw new Error(`Unknown harness: ${unknown.join(', ')}. Choose from: ${RELEASE_HARNESSES.join(', ')}`);
+  }
+  if (!requested.size) throw new Error('No harness selected; omit --harnesses to bundle all of them');
+  const warnings = [];
+  // ripgrep is a tool, not an agent, but Pi's search and file tools depend on it.
+  if (requested.has('pi-bin') && !requested.has('ripgrep-bin')) {
+    warnings.push('pi-bin is selected without ripgrep-bin; Pi search and file tools need ripgrep, so bundle both.');
+  }
+  return { harnesses: RELEASE_HARNESSES.filter(name => requested.has(name)), warnings };
+}
diff --git a/apps/host/src/release-harnesses.test.mjs b/apps/host/src/release-harnesses.test.mjs
new file mode 100644
index 0000000000..6742672f89
--- /dev/null
+++ b/apps/host/src/release-harnesses.test.mjs
@@ -0,0 +1,29 @@
+// Protects the release harness selection used by scripts/build.mjs: which agent
+// runtimes a standalone Host bundles, and that a bad selection fails before the
+// build instead of shipping a release without an agent. Unit tier, no I/O.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { RELEASE_HARNESSES, selectReleaseHarnesses } from './release-harnesses.mjs';
+
+test('bundles every harness when nothing is selected', () => {
+  for (const input of [{ env: {} }, { env: { CINDY_HOST_HARNESSES: '' } }]) {
+    assert.deepEqual(selectReleaseHarnesses(input), { harnesses: [...RELEASE_HARNESSES], warnings: [] });
+  }
+});
+
+test('--harnesses takes precedence over CINDY_HOST_HARNESSES', () => {
+  const env = { CINDY_HOST_HARNESSES: 'claude-code-bin' };
+  assert.deepEqual(selectReleaseHarnesses({ option: 'pi-bin, ripgrep-bin', env }).harnesses, ['pi-bin', 'ripgrep-bin']);
+  assert.deepEqual(selectReleaseHarnesses({ env }).harnesses, ['claude-code-bin']);
+});
+
+test('rejects unknown or empty selections before any build work', () => {
+  assert.throws(() => selectReleaseHarnesses({ option: 'pi-bin,pi', env: {} }), /Unknown harness: pi\. Choose from:/);
+  assert.throws(() => selectReleaseHarnesses({ option: ' , ', env: {} }), /No harness selected/);
+});
+
+test('warns when Pi is bundled without the ripgrep it searches with', () => {
+  assert.match(selectReleaseHarnesses({ option: 'pi-bin', env: {} }).warnings[0], /ripgrep-bin/);
+  assert.deepEqual(selectReleaseHarnesses({ option: 'ripgrep-bin,pi-bin', env: {} }).warnings, []);
+});
