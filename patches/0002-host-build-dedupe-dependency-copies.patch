diff --git a/apps/host/src/release-dependency-copies.mjs b/apps/host/src/release-dependency-copies.mjs
new file mode 100644
index 0000000000..2c977a0849
--- /dev/null
+++ b/apps/host/src/release-dependency-copies.mjs
@@ -0,0 +1,43 @@
+import path from 'node:path';
+
+/**
+ * Nested dependency copies in a standalone Host release that Node would never load.
+ *
+ * Node resolves a bare specifier by walking up from the importing package's
+ * directory through each enclosing `node_modules`. A copy is redundant when the
+ * nearest enclosing copy of the same package name is the same source: removing it
+ * makes every importer that found it continue upward to that identical copy, so
+ * each import still resolves to the same package. A different version in between
+ * shadows the outer copy and keeps this one.
+ *
+ * Decided on the complete layout, after every copy is placed: deciding while the
+ * tree is still being copied misses a different version written later in between.
+ *
+ * @param {Map<string, string>} copies release destination dir -> source package dir
+ * @param {string} root release root; nothing outside it is considered
+ * @returns {string[]} destinations to remove, shallowest first
+ */
+export function redundantCopies(copies, root) {
+  const redundant = [];
+  for (const [destination, source] of copies) {
+    const parts = destination.split(path.sep);
+    const at = parts.lastIndexOf('node_modules');
+    if (at < 0) continue;
+    const name = parts.slice(at + 1).join('/');
+    const parent = parts.slice(0, at).join(path.sep);
+    for (let dir = path.dirname(parent); dir === root || dir.startsWith(root + path.sep); dir = path.dirname(dir)) {
+      // The release only creates node_modules inside package roots, never directly
+      // under a `node_modules` or `@scope` directory, so there is nothing to find.
+      const base = path.basename(dir);
+      if (base !== 'node_modules' && !base.startsWith('@')) {
+        const candidate = path.join(dir, 'node_modules', ...name.split('/'));
+        if (copies.has(candidate)) {
+          if (copies.get(candidate) === source) redundant.push(destination);
+          break;
+        }
+      }
+      if (dir === root) break;
+    }
+  }
+  return redundant.sort((a, b) => a.length - b.length);
+}
diff --git a/apps/host/src/release-dependency-copies.test.mjs b/apps/host/src/release-dependency-copies.test.mjs
new file mode 100644
index 0000000000..c94675dd0d
--- /dev/null
+++ b/apps/host/src/release-dependency-copies.test.mjs
@@ -0,0 +1,38 @@
+// Protects the dependency dedupe in scripts/build.mjs: a nested copy is removed
+// only when Node would resolve the same package from an enclosing node_modules in
+// the final layout, so every import keeps resolving to the same version.
+// Unit tier, no I/O.
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import test from 'node:test';
+
+import { redundantCopies } from './release-dependency-copies.mjs';
+
+const root = path.join('/release');
+const nm = (...names) => path.join(root, ...names.flatMap(name => ['node_modules', ...name.split('/')]));
+
+test('removes nested copies whose nearest enclosing copy is the same source, shallowest first', () => {
+  const copies = new Map([
+    [nm('tslib'), '/store/tslib@2'],
+    [nm('a'), '/store/a'], [nm('a', 'tslib'), '/store/tslib@2'],
+    [nm('a', 'b'), '/store/b'], [nm('a', 'b', 'tslib'), '/store/tslib@2'],
+    [nm('@aws-sdk/core'), '/store/core@3'], [nm('a', '@aws-sdk/core'), '/store/core@3'],
+  ]);
+  assert.deepEqual(redundantCopies(copies, root), [nm('a', 'tslib'), nm('a', '@aws-sdk/core'), nm('a', 'b', 'tslib')]);
+});
+
+test('keeps a copy shadowed by a different version written later in the copy order', () => {
+  // A -> [X@2, B]; B -> [C, X@1]; C -> X@2. B/node_modules/X@1 is copied after C, and
+  // without C's own X@2, Node would resolve C's import of X to X@1.
+  const copies = new Map([
+    [nm('a'), '/store/a'], [nm('a', 'x'), '/store/x@2'], [nm('a', 'b'), '/store/b'],
+    [nm('a', 'b', 'c'), '/store/c'], [nm('a', 'b', 'c', 'x'), '/store/x@2'],
+    [nm('a', 'b', 'x'), '/store/x@1'],
+  ]);
+  assert.deepEqual(redundantCopies(copies, root), []);
+});
+
+test('never looks outside the release root', () => {
+  const copies = new Map([[path.join('/node_modules', 'tslib'), '/store/tslib@2'], [nm('a', 'tslib'), '/store/tslib@2']]);
+  assert.deepEqual(redundantCopies(copies, root), []);
+});
