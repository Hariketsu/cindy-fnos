diff --git a/apps/host/src/credentials/store.test.mjs b/apps/host/src/credentials/store.test.mjs
index ece26c6b..8bf9cf86 100644
--- a/apps/host/src/credentials/store.test.mjs
+++ b/apps/host/src/credentials/store.test.mjs
@@ -66,6 +66,54 @@ test('missing Secret Service fails explicitly instead of degrading to plaintext'
   assert.equal(fs.existsSync(path.join(userDataDir, 'safe-storage', 'session.enc')), false);
 });
 
+// CINDY_HOST_CREDENTIAL_KEY_FILE replaces Secret Service on headless Linux. It
+// must decrypt records sealed with the same keyring secret (no format fork) and
+// must refuse a shared, missing or empty file instead of degrading.
+function restoreKeyFileEnv(t) {
+  const previous = process.env.CINDY_HOST_CREDENTIAL_KEY_FILE;
+  t.after(() => {
+    if (previous === undefined) delete process.env.CINDY_HOST_CREDENTIAL_KEY_FILE;
+    else process.env.CINDY_HOST_CREDENTIAL_KEY_FILE = previous;
+  });
+}
+
+function writeKeyFile(t, contents, mode = 0o600) {
+  const file = path.join(tempProfile(t), 'credential-key');
+  if (contents !== undefined) {
+    fs.writeFileSync(file, contents);
+    fs.chmodSync(file, mode); // explicit, so the case does not depend on the umask
+  }
+  return file;
+}
+
+test('key file holding the keyring secret reads records sealed with the keyring key', async (t) => {
+  restoreKeyFileEnv(t);
+  const userDataDir = tempProfile(t);
+  const keyring = await createPreparedLinuxCredentialStore({ userDataDir, keyPromise: Promise.resolve(testKey()) });
+  keyring.write('session', 'secret-value');
+
+  process.env.CINDY_HOST_CREDENTIAL_KEY_FILE = writeKeyFile(t, `${TEST_SECRET}\n`);
+  const store = await createPreparedLinuxCredentialStore({ userDataDir });
+  assert.equal(store.read('session'), 'secret-value');
+});
+
+test('unusable key file fails explicitly instead of falling back to the keyring', async (t) => {
+  restoreKeyFileEnv(t);
+  for (const { name, contents, mode, message } of [
+    { name: 'group/world readable', contents: TEST_SECRET, mode: 0o644, message: /group or others/ },
+    { name: 'missing', contents: undefined, message: /ENOENT/ },
+    { name: 'empty', contents: '\n', message: /is empty/ },
+  ]) {
+    process.env.CINDY_HOST_CREDENTIAL_KEY_FILE = writeKeyFile(t, contents, mode);
+    await assert.rejects(
+      createPreparedLinuxCredentialStore({ userDataDir: tempProfile(t) }),
+      (error) => error instanceof SafeStorageUnavailableError && error.code === 'CREDENTIAL_STORE_UNAVAILABLE'
+        && /CINDY_HOST_CREDENTIAL_KEY_FILE/.test(error.message) && message.test(error.message),
+      name,
+    );
+  }
+});
+
